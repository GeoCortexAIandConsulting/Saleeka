# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# Database: leave MONGODB_URI empty to use the in-memory demo store (data resets on restart)
MONGODB_URI=
MONGODB_DB=saleeqa

# Language model: "rules" works offline with no model. "openai" uses any OpenAI-compatible
# server (Ollama, vLLM, Groq, OpenRouter, ...) for request parsing and look explanations.
LLM_PROVIDER=rules
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
# How long to wait for the AI stylist before using the rule composer (raise for slow local models)
LLM_STYLE_TIMEOUT_MS=25000

# Optional: enables GET /api/partners/:brandId/report (send as x-admin-key header)
ADMIN_KEY=

# Email confirmation for new players: on = they must open a link before signing in. Off for now.
EMAIL_CONFIRMATION=off

# The admin portal (/admin): its own username and password, separate from player accounts.
# The portal stays off until both are set; on a live server the password needs 12+ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# What one AI preview image costs in US dollars (for the admin portal's spending figures)
PREVIEW_COST_USD=0.13

# Optional: AI preview of a Studio look on a model (Gemini on Vertex AI, billed to your Google Cloud
# project). Leave GOOGLE_CLOUD_PROJECT empty to hide the preview.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Easiest sign-in (works on any computer and on Render): a Google Cloud API key restricted to the
# Vertex AI API (Cloud Console > APIs & Services > Credentials). When set, no gcloud sign-in is needed
# and the preview is on even with GOOGLE_CLOUD_PROJECT empty.
GOOGLE_API_KEY=
# Otherwise, on your own computer, run `gcloud auth application-default login` once (no key file).
# Only if your organisation allows service-account keys: the key's path (else leave this unset).
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa-key.json
PREVIEW_MODEL=gemini-3-pro-image
# What previews cost you is capped (defaults shown): free previews per account for life, friends who must
# join from a player's share link and publish a look to earn them one more (and the most they can earn),
# new images per player per day, new images across everyone per day, and whether a confirmed email is needed.
# PREVIEW_FREE=1
# PREVIEW_FRIENDS_FOR_CREDIT=3
# PREVIEW_FRIEND_CREDIT_CAP=5
# PREVIEW_DAILY_LIMIT=10
# PREVIEW_GLOBAL_DAILY_CAP=300
# PREVIEW_REQUIRE_VERIFIED_EMAIL=true
# Emergency switch: stops new previews for everyone (publishing still works). 0 for a limit above also means none.
# PREVIEWS_OFF=true

# Account emails (confirm email, reset password). resend or brevo, both with free tiers; EMAIL_FROM
# must be an address (or domain) the provider has verified. Leave EMAIL_PROVIDER empty and the emails
# are printed in this server's log instead (fine on a laptop).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=Saleeqa <hello@your-domain.com>
