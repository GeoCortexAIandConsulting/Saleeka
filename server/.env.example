# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# Database: leave MONGODB_URI empty to use the in-memory demo store (data resets on restart)
MONGODB_URI=
MONGODB_DB=saleeqa

# Language model: "rules" works offline with no model. "openai" uses any OpenAI-compatible
# server (Ollama, vLLM, Groq, OpenRouter, ...) for request parsing and look explanations.
LLM_PROVIDER=rules
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=

# Optional: enables GET /api/partners/:brandId/report (send as x-admin-key header)
ADMIN_KEY=
